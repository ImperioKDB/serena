# Serena development configuration
NODE_ENV=development
BROWSER_NAVIGATION_TIMEOUT_MS=10000
DATABASE_URL=
SUPABASE_URL=https://nmlhcofasxsngmvjjxti.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Optional legacy server-to-server bearer credential; never configure in the frontend.
SERENA_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional Firecrawl free-tier key; keyless search is attempted if omitted.
FIRECRAWL_API_KEY=
# Optional Tavily fallback key; Firecrawl keyless search works without it.
TAVILY_API_KEY=
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
# Gemini is optional and disabled unless explicitly enabled; keep API keys on the server only.
# Google's free-tier prompts may be used to improve products; do not send sensitive or personal data.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Fallbacks are never inferred; list only providers you explicitly authorize, e.g. gemini,openai-compatible.
SERENA_MODEL_PROVIDER_ORDER=
# Bounded research limits. Vercel's configured function ceiling is 180 seconds.
SERENA_MAX_DISCOVERY_CANDIDATES=10
SERENA_MAX_EVIDENCE_SOURCES=5
SERENA_RESEARCH_BUDGET_MS=90000
SERENA_SOURCE_TIMEOUT_MS=10000
SERENA_MAX_SOURCE_TIMEOUT_MS=15000
SERENA_CANDIDATE_EVALUATION_TIMEOUT_MS=4000
SERENA_EVIDENCE_ANALYSIS_TIMEOUT_MS=15000
PORT=3000
